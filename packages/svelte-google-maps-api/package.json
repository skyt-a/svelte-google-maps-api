			"types": "./dist/places/PlaceAutocomplete.svelte.d.ts",
			"svelte": "./dist/places/PlaceAutocomplete.svelte"
		},
		"./RouteRenderer.svelte": {
			"types": "./dist/routes/RouteRenderer.svelte.d.ts",
			"svelte": "./dist/routes/RouteRenderer.svelte"
		},
		"./StreetViewPanorama.svelte": {
			"types": "./dist/street-view/StreetViewPanorama.svelte.d.ts",
			"svelte": "./dist/street-view/StreetViewPanorama.svelte"
		}
	},
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.11",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@types/google.maps": "^3.66.9",
		"jsdom": "^26.0.0",
		"publint": "^0.1.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^6.3.5",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@googlemaps/markerclusterer": "^2.6.2"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"google-maps",
		"google maps",
		"maps",
		"advanced-markers",
		"places",
		"routes",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/skyt-a/svelte-google-maps-api.git",
		"directory": "packages/svelte-google-maps-api"
	},
	"homepage": "https://skyt-a.github.io/svelte-google-maps-api/",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
