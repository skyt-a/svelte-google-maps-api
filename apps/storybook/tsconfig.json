{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"sourceMap": true,
		"types": [
			"google.maps",
			"vite/client"
		]
	},
	"include": [
		".storybook/**/*",
		"src/**/*"
	]
}
